{
  "schemaVersion": 1,
  "id": "advancementlock",
  "version": "${version}",
  "name": "AdvancementLock",
  "description": "A mod that limits you by needing to complete advancements!",
  "authors": ["AFVSuper"],
  "contributors": ["HoradelJuego"],
  "contact": {
    "sources": "https://github.com/AFVSuper/AdvancementLock",
    "issues": "https://github.com/AFVSuper/AdvancementLock/issues"
  },
  "license": "MIT",
  "icon": "assets/advancementlock/icon.png",
  "environment": "*",
  "entrypoints": {
    "fabric-datagen": [
      "org.afv.advancementlock.client.AdvancementLockDataGenerator"
    ],
    "client": [
      "org.afv.advancementlock.client.AdvancementLockClient"
    ],
    "main": [
      "org.afv.advancementlock.AdvancementLock"
    ],
    "modmenu" : [
      "org.afv.advancementlock.client.config.ModMenuIntegration"
    ]
  },
  "mixins": [
    "advancementlock.mixins.json",
    {
      "config": "advancementlock.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric": "*",
    "minecraft": "${minecraft_version}",
    "cloth-config": ">=19.0.0",
    "modmenu": ">=11.0.0"
  },
  "custom": {
    "modmenu": {
      "links": {
        "modmenu.patreon": "https://patreon.com/AFVSuper",
        "modmenu.modrinth": "https://modrinth.com/mod/advancementlock"
      }
    }
  }
}
